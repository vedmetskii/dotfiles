{
  "layer": "top", // Waybar at top layer
  "exclusive": true,
  "position": "top", // Waybar position (top|bottom|left|right)
  // "width": 1280, // Waybar width
  // Choose the order of the modules
  "modules-left": ["hyprland/workspaces", "niri/workspaces", "custom/music"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/notification",
    "hyprland/language",
    "niri/language",
    "pulseaudio",
    "battery",
    "tray",
    "custom/power",
  ],
  "include": [
    "$HOME/.config/waybar/conf.d/custom-notification.jsonc",
    "$HOME/.config/waybar/conf.d/pulseaudio.jsonc",
    "$HOME/.config/waybar/conf.d/hyprland.jsonc",
    "$HOME/.config/waybar/conf.d/battery.jsonc",
    "$HOME/.config/waybar/conf.d/clock.jsonc",
    "$HOME/.config/waybar/conf.d/power.jsonc",
    "$HOME/.config/waybar/conf.d/music.jsonc",
    "$HOME/.config/waybar/conf.d/tray.jsonc",
    "$HOME/.config/waybar/conf.d/niri.jsonc",
  ],
}
